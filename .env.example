# استخدم نفس مشروع Supabase الذي يعمل عليه تطبيق Android.
# هذان المفتاحان آمنان للواجهة بشرط أن تكون RLS مفعلة كما في ملف supabase/android_multitenant_schema.sql
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# اختياري: لو تريد أن يقرأ الويب المفاتيح من نفس Cloudflare Worker الخاص بالتطبيق.
# NEXT_PUBLIC_CONFIG_URL=https://your-worker.workers.dev/config
